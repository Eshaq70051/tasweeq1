{
    "version": 2,
    "framework": null,
    "outputDirectory": "public",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "/media/(.*)",
            "dest": "/public/media/$1"
        },
        {
            "src": "/storage/(.*)",
            "dest": "/public/media/$1"
        },
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "tasweeq",
        "APP_ENV": "production",
        "APP_KEY": "base64:1fwl6k1eXxWqh6sQUxe1XFh0yCPTvV+J4MnSid9i38M=",
        "APP_DEBUG": "false",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "aws-1-eu-central-1.pooler.supabase.com",
        "DB_PORT": "5432",
        "DB_DATABASE": "postgres",
        "DB_USERNAME": "postgres.jxoibykervmxjlhyvrkc",
        "DB_PASSWORD": "eshaq777476080eshaq",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_STORE": "array",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",
        "LOG_CHANNEL": "stderr"
    }
}
